local function AimAtTarget( targetHRP )
    if not targetHRP then
        return end
    local camera = Workspace.CurrentCamera
    if not camera then
        return end
    camera.CFrame = CFrame.new( camera.CFrame.Position, targetHRP.Position )
end

-- ============================================================
-- R / Z Silent Aim
--
-- 直接照 8000 行 CVXHub 的核心機制：
-- 記錄最後技能 -> 持續選目標 -> 改 Mouse.Hit / Target / UnitRay。
-- 真正的 R / Z 仍由 Blox Fruits 自己執行。
-- ============================================================
local LastSkillPressed = nil

local CurrentRAimTarget = nil
local CurrentRAimTargetPos = nil
local CurrentZAimTarget = nil
local CurrentZAimTargetPos = nil
local CurrentCAimTarget = nil
local CurrentCAimTargetPos = nil

-- R 在遊戲原生判定前先進入自瞄狀態。
-- 這樣原生 Flash Step 做 Mouse.Hit / range check 時，
-- 一開始讀到的就是敵人，而不是你真正滑鼠指著的位置。
local RForceAimUntil = 0

-- 神人拳 C / 血拳 C 都共用這個提前自瞄窗口。
-- 對蓄力 C 很重要：按住期間持續鎖定，放開後也保留短暫尾窗，
-- 讓遊戲在真正出招的那一刻讀到敵人而不是滑鼠原位置。
local CForceAimUntil = 0

local function ClearRAimTarget()
    CurrentRAimTarget = nil
    CurrentRAimTargetPos = nil
end

local function ClearZAimTarget()
    CurrentZAimTarget = nil
    CurrentZAimTargetPos = nil
end

local function ClearCAimTarget()
    CurrentCAimTarget = nil
    CurrentCAimTargetPos = nil
end

local function UpdateRAimTarget()
    if not Settings.EnableFlashStep then
        ClearRAimTarget()
        return
    end

    local myHRP = GetHRP()
    if not myHRP then
        ClearRAimTarget()
        return
    end

    local enemy = GetNearestEnemy(myHRP, Settings.FlashStepRange)
    if enemy and enemy.HRP and enemy.HRP.Parent then
        CurrentRAimTarget = enemy.HRP
        CurrentRAimTargetPos = enemy.HRP.Position
    else
        ClearRAimTarget()
    end
end

local function UpdateZAimTarget()
    if not Settings.ZAimbot or IsCBlocked() then
        ClearZAimTarget()
        return
    end

    if not IsToolEquipped(Settings.DoorFruitKeywords) then
        ClearZAimTarget()
        return
    end

    local myHRP = GetHRP()
    if not myHRP then
        ClearZAimTarget()
        return
    end

    local enemy = GetNearestEnemy(myHRP, Settings.MaxDistance)
    if enemy and enemy.HRP and enemy.HRP.Parent then
        CurrentZAimTarget = enemy.HRP
        CurrentZAimTargetPos = enemy.HRP.Position
    else
        ClearZAimTarget()
    end
end

local function IsCAimStyleEquipped()
    return IsToolEquipped(Settings.GodhumanKeywords)
        or IsToolEquipped(Settings.SanguineKeywords)
end

local function UpdateCAimTarget()
    if not Settings.CAimbot
        or IsCAimTemporarilyBlocked()
        or not IsCAimStyleEquipped()
    then
        ClearCAimTarget()
        return
    end

    local myHRP = GetHRP()
    if not myHRP then
        ClearCAimTarget()
        return
    end

    local enemy = GetNearestEnemy(myHRP, Settings.MaxDistance)
    if enemy and enemy.HRP and enemy.HRP.Parent then
        CurrentCAimTarget = enemy.HRP
        CurrentCAimTargetPos = enemy.HRP.Position
    else
        ClearCAimTarget()
    end
end

local function GetCurrentSilentAimTarget()
    -- R 要優先於遊戲自己的目的地判定。
    -- 不等 LastSkillPressed 才開始，因為那可能晚於遊戲的原生 Input handler。
    local rActive =
        UserInputService:IsKeyDown(Enum.KeyCode.R)
        or os.clock() < RForceAimUntil

    if rActive
        and Settings.EnableFlashStep
        and CurrentRAimTarget
        and CurrentRAimTarget.Parent
        and CurrentRAimTargetPos
    then
        return CurrentRAimTarget, CurrentRAimTargetPos
    end

    local cActive =
        UserInputService:IsKeyDown(Enum.KeyCode.C)
        or os.clock() < CForceAimUntil

    if cActive
        and Settings.CAimbot
        and not IsCAimTemporarilyBlocked()
        and IsCAimStyleEquipped()
        and CurrentCAimTarget
        and CurrentCAimTarget.Parent
        and CurrentCAimTargetPos
    then
        return CurrentCAimTarget, CurrentCAimTargetPos
    end

    if LastSkillPressed == "Z"
        and Settings.ZAimbot
        and not IsCBlocked()
        and IsToolEquipped(Settings.DoorFruitKeywords)
        and CurrentZAimTarget
        and CurrentZAimTarget.Parent
        and CurrentZAimTargetPos
    then
        return CurrentZAimTarget, CurrentZAimTargetPos
    end

    return nil, nil
end

local function InstallEarlyRPreArm()
    pcall(function()
        ContextActionService:UnbindAction("CVX_R_EARLY_PREARM")
    end)

    ContextActionService:BindActionAtPriority(
        "CVX_R_EARLY_PREARM",
        function(_, inputState, inputObject)
            if inputObject
                and inputObject.KeyCode == Enum.KeyCode.R
            then
                if inputState == Enum.UserInputState.Begin then
                    -- 先刷新敵人，再把 R 自瞄窗口打開。
                    UpdateRAimTarget()
                    LastSkillPressed = "R"
                    RForceAimUntil = os.clock() + 0.35
                elseif inputState == Enum.UserInputState.End
                    or inputState == Enum.UserInputState.Cancel
                then
                    -- 保留極短尾窗，避免遊戲在 KeyUp 後才讀 Mouse.Hit。
                    RForceAimUntil = os.clock() + 0.12
                end
            end

            -- 不攔截原生 R；只提前準備目標。
            return Enum.ContextActionResult.Pass
        end,
        false,
        1000000,
        Enum.KeyCode.R
    )
end

local function InstallEarlyCPreArm()
    pcall(function()
        ContextActionService:UnbindAction("CVX_C_EARLY_PREARM")
    end)

    ContextActionService:BindActionAtPriority(
        "CVX_C_EARLY_PREARM",
        function(_, inputState, inputObject)
            if inputObject
                and inputObject.KeyCode == Enum.KeyCode.C
            then
                if inputState == Enum.UserInputState.Begin then
                    if Settings.CAimbot
                        and not IsCAimTemporarilyBlocked()
                        and IsCAimStyleEquipped()
                    then
                        UpdateCAimTarget()
                        LastSkillPressed = "C"
                        CForceAimUntil = os.clock() + 0.40
                    end
                elseif inputState == Enum.UserInputState.End
                    or inputState == Enum.UserInputState.Cancel
                then
                    if Settings.CAimbot
                        and not IsCAimTemporarilyBlocked()
                        and IsCAimStyleEquipped()
                    then
                        UpdateCAimTarget()
                        CForceAimUntil = os.clock() + 0.20
                    end
                end
            end

            -- 不攔截遊戲原生 C，只提前把 Mouse 目標換成敵人。
            return Enum.ContextActionResult.Pass
        end,
        false,
        1000000,
        Enum.KeyCode.C
    )
end

local function InstallRZSilentAimHooks()
    if type(getrawmetatable) ~= "function"
        or type(setreadonly) ~= "function"
        or type(newcclosure) ~= "function"
        or type(checkcaller) ~= "function"
    then
        return
    end

    -- 與 8000 行 CVXHub 一樣：Hook ReplicatedStorage.Mouse
    task.spawn(function()
        local MouseModuleInstance = ReplicatedStorage:WaitForChild("Mouse", 5)
        if MouseModuleInstance then
            pcall(function()
                local MouseModule = require(MouseModuleInstance)
                if typeof(MouseModule) == "table" then
                    local realStore = {
                        Hit = rawget(MouseModule, "Hit"),
                        Target = rawget(MouseModule, "Target")
                    }

                    local mmt = getrawmetatable(MouseModule) or {}
                    setreadonly(mmt, false)

                    rawset(MouseModule, "Hit", nil)
                    rawset(MouseModule, "Target", nil)

                    mmt.__index = function(self, key)
                        local target, targetPos = GetCurrentSilentAimTarget()

                        if key == "Hit" then
                            if target and targetPos then
                                return CFrame.new(targetPos)
                            end
                            return realStore.Hit
                        elseif key == "Target" then
                            if target and targetPos then
                                return target
                            end
                            return realStore.Target
                        end

                        return rawget(self, key)
                    end

                    mmt.__newindex = function(self, key, value)
                        if key == "Hit" or key == "Target" then
                            realStore[key] = value
                        else
                            rawset(self, key, value)
                        end
                    end

                    setreadonly(mmt, true)
                    setmetatable(MouseModule, mmt)
                end
            end)
        end
    end)

    -- 與 8000 行 CVXHub 一樣：Hook LocalPlayer:GetMouse()
    pcall(function()
        local gmt = getrawmetatable(game)
        if not gmt then return end

        setreadonly(gmt, false)
        local oldIndex = gmt.__index
        local playerMouse = LocalPlayer:GetMouse()

        gmt.__index = newcclosure(function(self, key)
            if not checkcaller() and self == playerMouse then
                local target, targetPos = GetCurrentSilentAimTarget()

                if target and targetPos then
                    local camera = Workspace.CurrentCamera
                    local camPos = camera and camera.CFrame.Position

                    if key == "Hit" then
                        return CFrame.new(targetPos)
                    elseif key == "Target" then
                        return target
                    elseif camPos and key == "UnitRay" then
                        return Ray.new(camPos, (targetPos - camPos).Unit)
                    elseif camPos and key == "Origin" then
                        return CFrame.new(camPos)
                    elseif camPos and key == "Direction" then
                        return (targetPos - camPos).Unit
                    end
                end
            end

            return oldIndex(self, key)
        end)

        setreadonly(gmt, true)
    end)
end

