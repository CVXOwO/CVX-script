RunService:BindToRenderStep( "MainInputHook", Enum.RenderPriority.Input.Value + 100, function()
        -- ==================== Sanguine C -> Z Lock ====================
        -- 只有使用 Sanguine Art 的 C 時，才鎖定 Z 2 秒。
        if UserInputService:IsKeyDown( Enum.KeyCode.C ) and IsToolEquipped( Settings.SanguineKeywords ) then
            LastCTime = os.clock()
        end

        -- 神人拳 C / 血拳 C 共用同一個 C AIMBOT 開關。
        if Settings.CAimbot
            and not IsCAimTemporarilyBlocked()
            and UserInputService:IsKeyDown( Enum.KeyCode.C )
            and IsCAimStyleEquipped()
        then
            LastSkillPressed = "C"
            UpdateCAimTarget()
            CForceAimUntil = os.clock() + 0.20
        elseif IsCAimTemporarilyBlocked() then
            CForceAimUntil = 0
            ClearCAimTarget()
        end

        -- InputBegan 已保證快速點按會即時執行；
        -- 這裡只負責按住期間持續維持 R / Z。
        if RHeld or UserInputService:IsKeyDown( Enum.KeyCode.R ) then
            TryFlashStep()
        end
        if ZHeld or UserInputService:IsKeyDown( Enum.KeyCode.Z ) then
            TryZAim()
        end
    end )
