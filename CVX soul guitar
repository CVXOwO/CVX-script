-- ==================== 核心邏輯 ====================
local function GetHRP()
    local char = LocalPlayer.Character
    if not char then
        return nil
    end
    local humanoid = char:FindFirstChildOfClass( "Humanoid" )
    if not humanoid or humanoid.Health <= 0 then
        return nil
    end
    return char:FindFirstChild( "HumanoidRootPart" )
end
local function CheckObstacle( origin, direction, distance )
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = { LocalPlayer.Character }
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    return Workspace:Raycast( origin, direction.Unit * distance, raycastParams ) ~= nil
end
-- ============================================================
-- Soul Guitar Glitch
-- ============================================================
local function SetGlitchFlyState( state, direction )
    IsGlitchFlying = state
    local hrp = GetHRP()
    if not hrp then
        return end
    if state then
        GlitchFlyDirection = direction
        for _, v in ipairs( hrp:GetChildren() ) do
            if v.Name == "GlitchFlySmooth" then
                v:Destroy()
            end
        end
        local bv = Instance.new( "BodyVelocity" )
        bv.Name = "GlitchFlySmooth"
        -- Y 軸不施力，保留遊戲原本重力
        bv.MaxForce = Vector3.new( math.huge, 0, math.huge )
        bv.Velocity = direction * Settings.GlitchFlySpeed
        bv.Parent = hrp
    else
        for _, v in ipairs( hrp:GetChildren() ) do
            if v.Name == "GlitchFlySmooth" then
                v:Destroy()
            end
        end
    end
end
