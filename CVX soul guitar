-- Flash Step Module Hook
-- ============================================================
local function ModifyFlashStepModule()
    task.defer( function()
            if not getgc then
                return end
            for _, obj in ipairs( getgc() ) do
                if type( obj ) == "table" then
                    for k, v in pairs( obj ) do
                        if type(k) == "string" and ( k:lower():find( "flash" ) or k:lower():find( "step" ) or k:lower():find( "teleport" ) ) and type(v) == "function" then
                            obj[k] = function(...)
                                    if not Settings.EnableFlashStep then
                                        return v(...)
                                    end
                                    local myHRP = GetHRP()
                                    if not myHRP then
                                        return v(...)
                                    end
                                    local enemy = GetNearestEnemy( myHRP, Settings.FlashStepRange )
                                    if enemy then
                                        myHRP.AssemblyLinearVelocity = Vector3.zero
                                        myHRP.AssemblyAngularVelocity = Vector3.zero
                                        return enemy.HRP.CFrame * CFrame.new( 0, 0, Settings.Offset )
                                    else
                                        return v(...)
                                    end
                                end
                        end
                    end
                end
            end
        end )
end
