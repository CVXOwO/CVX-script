-- 引擎迴圈
-- ============================================================
RunService.RenderStepped:Connect( function( deltaTime )
        local char = LocalPlayer.Character
        if not char then
            SetGlitchFlyState( false )
            return end
        local hum = char: FindFirstChildOfClass( "Humanoid" )
        local hrp = char: FindFirstChild( "HumanoidRootPart" )
        if not hum or not hrp or hum.Health <= 0 then
            SetGlitchFlyState( false )
            return end
        -- ====================================================
        -- R / Z Silent Aim target refresh
        -- ====================================================
        UpdateRAimTarget()
        UpdateZAimTarget()
        UpdateCAimTarget()

        -- ====================================================
        -- Combat Lock
        -- ====================================================
        UpdateCombatLock()
        -- ====================================================
        -- Soul Guitar Glitch
        -- ====================================================
        if Settings.EnableSoulGuitarGlitch and IsGlitchFlying then
            -- 使用技能期間強制停止
            if CombatLock then
                SetGlitchFlyState( false )
            elseif ( os.clock() - LastGlitchDash ) > 0.2 then
                if hum:GetState() == Enum.HumanoidStateType.Landed or hum.FloorMaterial ~= Enum.Material.Air then
                    SetGlitchFlyState( false )
                end
            end
        end
        -- ====================================================
        -- Combat Speed
        --
        -- CombatLock 開啟期間完全不執行。
        -- ====================================================
        if Settings.EnableSpeed and not IsGlitchFlying and not CombatLock then
            if hum.WalkSpeed > 5 and hum.FloorMaterial ~= Enum.Material.Air and hum.MoveDirection.Magnitude > 0 then
                if not CheckObstacle( hrp.Position, hum.MoveDirection, 2.5 ) then
                    hrp.CFrame = hrp.CFrame + ( hum.MoveDirection * ( Settings.SpeedValue - 16 ) * deltaTime )
                end
            end
        end
    end )
-- ============================================================
-- Reliable R / Z Input
-- InputBegan 立即執行一次；RenderStep 在按住期間持續維持。
-- 避免快速點按或掉幀時 IsKeyDown 單獨輪詢漏掉輸入。
-- ============================================================
local RHeld = false
local ZHeld = false

local function TryFlashStep()
    -- 不自己瞬移、不自己 FireServer。
    -- 只讓 Blox Fruits 原生 R 讀到敵人的 Mouse.Hit / Target。
    LastSkillPressed = "R"
    UpdateRAimTarget()
end

local function TryZAim()
    -- 不轉 Camera，只改原生技能讀到的目標。
    LastSkillPressed = "Z"
    UpdateZAimTarget()
end

-- ============================================================
-- Input Began
-- ============================================================
UserInputService.InputBegan:Connect( function( input, gp )
        if UserInputService: GetFocusedTextBox() then
            return end
        local kc = input.KeyCode
        local uit = input.UserInputType

        -- Dragonheart Z / TTK X 使用後，2 秒內禁止 C 自瞄。
        if kc == Enum.KeyCode.Z
            and IsToolEquipped(Settings.DragonheartKeywords)
        then
            LastCAimBlockTime = os.clock()
            CForceAimUntil = 0
            ClearCAimTarget()

        elseif kc == Enum.KeyCode.X
            and IsToolEquipped(Settings.TTKKeywords)
        then
            LastCAimBlockTime = os.clock()
            CForceAimUntil = 0
            ClearCAimTarget()
        end

        -- 與 8000 行 CVXHub 一樣：記錄最後按下的技能。
        if kc == Enum.KeyCode.R then
            UpdateRAimTarget()
            LastSkillPressed = "R"
            RForceAimUntil = os.clock() + 0.35
        elseif kc == Enum.KeyCode.Z then
            LastSkillPressed = "Z"
        elseif kc == Enum.KeyCode.X then
            LastSkillPressed = "X"
        elseif kc == Enum.KeyCode.C then
            if Settings.CAimbot
                and not IsCAimTemporarilyBlocked()
                and IsCAimStyleEquipped()
            then
                UpdateCAimTarget()
                CForceAimUntil = os.clock() + 0.40
            else
                CForceAimUntil = 0
                ClearCAimTarget()
            end
            LastSkillPressed = "C"
        elseif kc == Enum.KeyCode.V then
            LastSkillPressed = "V"
        elseif kc == Enum.KeyCode.F then
            LastSkillPressed = "F"
        elseif uit == Enum.UserInputType.MouseButton1 then
            LastSkillPressed = "M1"
        end

        -- R / Z 事件式即時觸發，避免快速點按被 RenderStep 漏掉
        if kc == Enum.KeyCode.R then
            RHeld = true
            TryFlashStep()
        elseif kc == Enum.KeyCode.Z then
            ZHeld = true
            TryZAim()
        end
        -- ====================================================
        -- M1 記錄
        -- ====================================================
        if uit == Enum.UserInputType.MouseButton1 then
            LastM1Time = os.clock()
        end
        -- ====================================================
        -- Z / X / C / V / F
        --
        -- 按下後 CombatLock 一直保持，
        -- 直到真正放開按鍵。
        -- ====================================================
        if IsCombatSkillKey( kc ) then
            HeldCombatSkills[ kc ] = true
            CombatUnlockTime = math.huge
            StartCombatLock()
        elseif uit == Enum.UserInputType.MouseButton1 then
            -- M1 不設持續鎖，
            -- 避免破壞 Q + Space + M1。
            SetGlitchFlyState( false )
            ApplyCombatBrake()
        elseif kc == Enum.KeyCode.Q then
            -- Q 仍保留原本的急煞效果，
            -- 但不套用持續 CombatLock。
            SetGlitchFlyState( false )
            ApplyCombatBrake()
        end
        -- ====================================================
        -- Soul Guitar Glitch
        --
        -- 技能 Lock 中禁止觸發。
        -- ====================================================
        if Settings.EnableSoulGuitarGlitch and not CombatLock then
            local char = LocalPlayer.Character
            local hum = char and char: FindFirstChildOfClass( "Humanoid" )
            if hum and not IsGlitchFlying and ( hum:GetState() == Enum.HumanoidStateType.Freefall or hum:GetState() == Enum.HumanoidStateType.Jumping or hum.FloorMaterial == Enum.Material.Air ) then
                if kc == Enum.KeyCode.Q or kc == Enum.KeyCode.Space or uit == Enum.UserInputType.MouseButton1 then
                    if IsToolEquipped( Settings.SoulGuitarKeywords ) then
                        local isDashPressed = UserInputService:IsKeyDown( Enum.KeyCode.Q ) or kc == Enum.KeyCode.Q
                        local isJumpPressed = UserInputService:IsKeyDown( Enum.KeyCode.Space ) or kc == Enum.KeyCode.Space
                        local isM1Recent = ( os.clock() - LastM1Time < 0.7 ) or UserInputService: IsMouseButtonPressed( Enum.UserInputType.MouseButton1 )
                        if isDashPressed and isJumpPressed and isM1Recent then
                            local now = os.clock()
                            if now - LastGlitchDash > 0.8 then
                                local camera = Workspace.CurrentCamera
                                if camera then
                                    local look = camera.CFrame.LookVector
                                    local horizontal = Vector3.new( look.X, 0, look.Z )
                                    if horizontal.Magnitude > 0 then
                                        local dir = horizontal.Unit
                                        LastGlitchDash = now
                                        SetGlitchFlyState( true, dir )
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end )
-- ============================================================
-- Input Ended
--
-- 蓄力技能的關鍵。
-- 只有真正放開技能鍵才開始準備解鎖。
-- ============================================================
UserInputService.InputEnded:Connect( function( input, gp )
        local kc = input.KeyCode

        if kc == Enum.KeyCode.R then
            RHeld = false
            RForceAimUntil = os.clock() + 0.12
        elseif kc == Enum.KeyCode.Z then
            ZHeld = false
        elseif kc == Enum.KeyCode.C then
            if Settings.CAimbot
                and not IsCAimTemporarilyBlocked()
                and IsCAimStyleEquipped()
            then
                UpdateCAimTarget()
                CForceAimUntil = os.clock() + 0.20
            else
                CForceAimUntil = 0
                ClearCAimTarget()
            end
        end

        if IsCombatSkillKey( kc ) then
            HeldCombatSkills[ kc ] = nil
            if not IsAnyCombatSkillHeld() then
                CombatUnlockTime = os.clock() + CombatUnlockDelay
            end
        end
    end )
