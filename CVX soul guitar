local function IsCombatSkillKey( keyCode )
    return keyCode == Enum.KeyCode.Z or keyCode == Enum.KeyCode.X or keyCode == Enum.KeyCode.C or keyCode == Enum.KeyCode.V or keyCode == Enum.KeyCode.F
end
local function IsAnyCombatSkillHeld()
    for _, held in pairs( HeldCombatSkills ) do
        if held then
            return true
        end
    end
    return false
end
-- ============================================================
-- 清除額外水平速度
-- ============================================================
local function ApplyCombatBrake()
    local hrp = GetHRP()
    if not hrp then
        return end
    hrp.AssemblyLinearVelocity = Vector3.new( 0, hrp.AssemblyLinearVelocity.Y, 0 )
end
-- ============================================================
-- 開始 Combat Lock
-- ============================================================
local function StartCombatLock()
    CombatLock = true
    -- 使用技能時立即中止吉他跳
    SetGlitchFlyState( false )
    -- 清掉殘留水平速度
    ApplyCombatBrake()
end
-- ============================================================
-- 更新 Combat Lock 狀態
-- ============================================================
local function UpdateCombatLock()
    -- 還有技能鍵正在按住
    if IsAnyCombatSkillHeld() then
        CombatLock = true
        if IsGlitchFlying then
            SetGlitchFlyState( false )
        end
        return end
    -- 技能剛放開
    -- 等待技能收尾時間
    if os.clock() < CombatUnlockTime then
        CombatLock = true
        if IsGlitchFlying then
            SetGlitchFlyState( false )
        end
        return end
    CombatLock = false
end
-- ============================================================
-- Tool Detection
-- ============================================================
local function IsToolEquipped( keywords )
    local char = LocalPlayer.Character
    if not char then return false end
    for _, tool in ipairs( char:GetChildren() ) do
        if tool:IsA( "Tool" ) then
            local toolName = tool.Name:lower()
            for _, keyword in ipairs( keywords ) do
                if toolName:find( keyword ) then return true end
            end
        end
    end
    return false
end
local function IsCBlocked()
    return ( os.clock() - LastCTime ) < Settings.SanguineCCooldown
end

local function IsCAimTemporarilyBlocked()
    return ( os.clock() - LastCAimBlockTime ) < Settings.CAimBlockCooldown
end
-- ============================================================
-- Team Check
-- ============================================================
local function IsTeammatePlayer( player )
    if not Settings.TeamCheck or not player or player == LocalPlayer then
        return false
    end

    local myTeam = LocalPlayer.Team
    local otherTeam = player.Team

    -- Marines: both Marines => friendly
    if myTeam and otherTeam
        and myTeam == otherTeam
        and myTeam.Name == "Marines"
    then
        return true
    end

    -- Real Blox Fruits Ally relation.
    -- Ally tags use the other player's Username.
    local allyTagOnTarget = "Ally" .. LocalPlayer.Name
    local allyTagOnLocal = "Ally" .. player.Name

    local isAlly = false

    pcall(function()
        isAlly =
            CollectionService:HasTag( player, allyTagOnTarget )
            or CollectionService:HasTag( LocalPlayer, allyTagOnLocal )
    end)

    if isAlly then
        return true
    end

    -- Pirate vs Pirate without an Ally relation remains targetable.
    return false
end
-- ============================================================
-- Target Search
-- ============================================================
local function GetNearestEnemy( myHRP, searchRange )
    if not myHRP then return nil end
    searchRange = searchRange or Settings.MaxDistance

    -- Target Lock：有效就直接使用；失效則 fallback 到正常搜尋
    if Settings.EnableTargetLock and Settings.TargetName ~= "" then
        local targetPlayer = Players:FindFirstChild( Settings.TargetName )
        if targetPlayer and targetPlayer ~= LocalPlayer and targetPlayer.Character and not IsTeammatePlayer( targetPlayer ) then
            local targetCharacter = targetPlayer.Character
            local eHRP = targetCharacter:FindFirstChild( "HumanoidRootPart" )
            local eHum = targetCharacter:FindFirstChildOfClass( "Humanoid" )
            if eHRP and eHum and eHum.Health > 0 and (eHRP.Position - myHRP.Position).Magnitude <= searchRange then
                return {
                    Character = targetCharacter,
                    Player = targetPlayer,
                    HRP = eHRP,
                    Pos = eHRP.Position
                }
            end
        end
    end

    local camera = Workspace.CurrentCamera
    if not camera then return nil end

    -- 使用同一個螢幕座標系，避免 Mouse.X/Y 與 ViewportPoint 的 GUI inset 誤差
    local mousePos = UserInputService:GetMouseLocation()
    local mouseRay = camera:ScreenPointToRay( mousePos.X, mousePos.Y )
    local mouseRayDir = mouseRay.Direction.Unit

    local bestVisible = nil
    local bestVisibleMouseDistance = math.huge

    local bestFallback = nil
    local bestFallbackAngle = math.huge

    for _, player in ipairs( Players:GetPlayers() ) do
        if player ~= LocalPlayer and not IsTeammatePlayer( player ) then
            local character = player.Character
            if character then
                local enemyHRP = character:FindFirstChild( "HumanoidRootPart" )
                local humanoid = character:FindFirstChildOfClass( "Humanoid" )

                if enemyHRP and humanoid and humanoid.Health > 0 then
                    local pos = enemyHRP.Position
                    local distPlayer = (pos - myHRP.Position).Magnitude

                    if distPlayer <= searchRange then
                        local candidate = {
                            Character = character,
                            Player = player,
                            HRP = enemyHRP,
                            Pos = pos
                        }

                        -- 第一優先：真正位於畫面內的玩家，取離滑鼠最近
                        local screenPos, onScreen = camera:WorldToScreenPoint( pos )
                        if onScreen and screenPos.Z > 0 then
                            local distMouse = (
                                Vector2.new( screenPos.X, screenPos.Y ) - mousePos
                            ).Magnitude

                            if distMouse < bestVisibleMouseDistance then
                                bestVisibleMouseDistance = distMouse
                                bestVisible = candidate
                            end
                        end

                        -- Fallback：只有畫面內完全沒有合法玩家時才用
                        -- 比較目標方向與滑鼠射線的夾角，不使用螢幕外的假投影座標
                        local toTarget = pos - mouseRay.Origin
                        if toTarget.Magnitude > 0 then
                            local dot = math.clamp(
                                mouseRayDir:Dot( toTarget.Unit ),
                                -1,
                                1
                            )
                            local angleScore = 1 - dot

                            if angleScore < bestFallbackAngle then
                                bestFallbackAngle = angleScore
                                bestFallback = candidate
                            end
                        end
                    end
                end
            end
        end
    end

    -- 只要畫面內有有效玩家，螢幕外 / 背後的人永遠不能搶目標
    return bestVisible or bestFallback
end

