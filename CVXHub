local function sendReport(reportText)
    reportText = tostring(reportText or ""):match("^%s*(.-)%s*$") or ""
    if reportText == "" then
        WindUI:Notify({ Title = "loc:UI_006", Content = "loc:UI_275", Duration = 3 })
        return
    end

    -- 防止連點造成重複送出。
    local now = os.clock()
    if now - LastReportSubmit < 2.5 then
        WindUI:Notify({ Title = "loc:UI_007", Content = "loc:UI_276", Duration = 2 })
        return
    end
    LastReportSubmit = now

    local requestFunc = GetHttpRequestFunction()
    if not requestFunc then
        WindUI:Notify({
            Title = "loc:UI_008",
            Content = "loc:UI_277",
            Duration = 4,
            Icon = "triangle-alert"
        })
        return
    end

    -- Discord Embed 單一欄位上限為 1024 字元，保留一些空間避免超限。
    if #reportText > 950 then
        reportText = string.sub(reportText, 1, 950) .. "\n...（內容過長，已截斷）"
    end

    local executor = (identifyexecutor and identifyexecutor()) or "未知執行器"
    local reporter = LocalPlayer and (LocalPlayer.Name .. " (" .. LocalPlayer.DisplayName .. ")") or "未知玩家"
    local reporterId = LocalPlayer and tostring(LocalPlayer.UserId) or "未知"
    local placeId = tostring(game.PlaceId)
    local jobId = game.JobId ~= "" and game.JobId or "單人/本地伺服器"

    local payload = {
        content = "<@" .. REPORT_PING_USER_ID .. "> 新的 CVX Hub Bug / 建議回報",
        allowed_mentions = { users = { REPORT_PING_USER_ID } },
        username = "CVX Hub 回報系統",
        embeds = {{
            title = "Bug / 建議回報",
            color = 5793266,
            fields = {
                { name = "回報者", value = reporter .. "\nRoblox ID: `" .. reporterId .. "`", inline = true },
                { name = "執行器", value = executor, inline = true },
                { name = "Place ID", value = "`" .. placeId .. "`", inline = true },
                { name = "Job ID", value = "```" .. jobId .. "```", inline = false },
                { name = "回報內容", value = reportText, inline = false }
            },
            footer = { text = "CVX Hub Feedback • " .. os.date("%Y-%m-%d %H:%M:%S") }
        }}
    }

    local ok, response = pcall(function()
        return requestFunc({
            Url = REPORT_WEBHOOK_URL,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode(payload)
        })
    end)

    local statusCode = response and (response.StatusCode or response.Status)
    local httpOK = ok and (statusCode == nil or (tonumber(statusCode) and tonumber(statusCode) >= 200 and tonumber(statusCode) < 300))

    if httpOK then
        WindUI:Notify({
            Title = "loc:UI_009",
            Content = "loc:UI_278",
            Duration = 3,
            Icon = "circle-check"
