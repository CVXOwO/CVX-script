local function _decode64(_s)
    if crypt then
        if type(crypt.base64decode) == "function" then
            local ok, value = pcall(crypt.base64decode, _s)
            if ok and type(value) == "string" then return value end
        end
        if crypt.base64 and type(crypt.base64.decode) == "function" then
            local ok, value = pcall(crypt.base64.decode, _s)
            if ok and type(value) == "string" then return value end
        end
    end
    if syn and syn.crypt then
        if type(syn.crypt.base64decode) == "function" then
            local ok, value = pcall(syn.crypt.base64decode, _s)
            if ok and type(value) == "string" then return value end
        end
        if syn.crypt.base64 and type(syn.crypt.base64.decode) == "function" then
            local ok, value = pcall(syn.crypt.base64.decode, _s)
            if ok and type(value) == "string" then return value end
        end
    end

    local _alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local _map = {}
    for i = 1, #_alphabet do
        _map[string.byte(_alphabet, i)] = i - 1
    end

    local _out = {}
    local _oi = 0
    local _len = #_s
    local i = 1

    while i <= _len do
        local a = _map[string.byte(_s, i)] or 0
        local b = _map[string.byte(_s, i + 1)] or 0
        local cByte = string.byte(_s, i + 2)
        local dByte = string.byte(_s, i + 3)
        local c = (cByte and cByte ~= 61) and (_map[cByte] or 0) or 0
        local d = (dByte and dByte ~= 61) and (_map[dByte] or 0) or 0

        local n = a * 262144 + b * 4096 + c * 64 + d

        _oi = _oi + 1
        if cByte == 61 or cByte == nil then
            _out[_oi] = string.char(math.floor(n / 65536) % 256)
        elseif dByte == 61 or dByte == nil then
            _out[_oi] = string.char(
                math.floor(n / 65536) % 256,
                math.floor(n / 256) % 256
            )
        else
            _out[_oi] = string.char(
                math.floor(n / 65536) % 256,
                math.floor(n / 256) % 256,
                n % 256
            )
        end

        i = i + 4
    end

    return table.concat(_out)
end

