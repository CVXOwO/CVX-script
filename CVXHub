local function notify(title, content, duration)
    if not WindUI then return end
    pcall(function()
        WindUI:Notify({
            Title = tostring(title or "CVX Hub"),
            Content = tostring(content or ""),
            Duration = tonumber(duration) or 3
        })
    end)
end

